<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top bar: back + title + Save text button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Add photo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"/>

        <!-- Save text button (blue text) -->
        <TextView
            android:id="@+id/btnSavePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

    <!-- Content area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <!-- Big dashed photo preview box -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginBottom="40dp">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/dashed_border_bg"
                android:scaleType="centerCrop"
                android:src="@drawable/img_placeholder"/>

            <!-- Overlay camera icon + text when no photo (gone when photo selected) -->
            <LinearLayout
                android:id="@+id/layoutNoPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F2F4F7">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/camera_icon"
                    android:scaleType="fitCenter"
                    android:alpha="0.5"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No photo selected"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Choose from Gallery — solid blue -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            android:layout_width="342dp"
            android:layout_height="60dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="12dp"
            android:text="Choose from Gallery"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:backgroundTint="#2563EB"
            app:icon="@drawable/gallery"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:cornerRadius="12dp"/>

        <!-- Take Photo — light grey -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamera"
            android:layout_width="342dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:text="Take Photo"
            android:textAllCaps="false"
            android:textColor="#374151"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:backgroundTint="#F3F4F6"
            app:icon="@drawable/camera"
            app:iconTint="#2563EB"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:cornerRadius="12dp"/>

        <!-- Info tip box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp"
            android:background="#EFF6FF"
            app:cornerRadius="12dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/query"
                android:scaleType="fitCenter"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Upload a high-quality photo to make your profile stand out. Max file size: 5MB."
                android:textSize="12sp"
                android:textColor="#374151"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
