<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvOrderCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Orders"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>
    </LinearLayout>

    <!-- Tab Layout: Pending | History -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutOrders"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="#FFFFFF"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#1A1A1A"
        app:tabTextColor="#888888"  app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
        app:tabIndicatorColor="#0F2CBD"
        app:tabIndicatorHeight="3dp"
        app:tabRippleColor="@null"
        style="@style/Widget.MaterialComponents.TabLayout"/>

    <!-- ViewPager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>