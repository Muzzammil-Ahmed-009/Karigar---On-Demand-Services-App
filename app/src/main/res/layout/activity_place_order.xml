<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <!-- Top Bar — white with bottom shadow -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/back"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Place Order"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <!-- Step counter badge -->
        <TextView
            android:id="@+id/tvStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 of 3"
            android:textSize="12sp"
            android:textColor="#0F2CBD"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="33"
        android:max="100"
        android:progressTint="#0F2CBD"
        android:backgroundTint="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/btnNextStep"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= STEP 1: CATEGORY ================= -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What service do you need?"
                    android:textSize="22sp"
                    android:textColor="#111111"
                    android:paddingBottom="16dp"
                    android:fontFamily="@font/poppins_bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="18dp"
                                android:background="#0F2CBD"
                                android:layout_marginRight="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Service Category"
                                android:textColor="#111111"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/layoutCategoryCards"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/btnAddCategory"
                                    android:layout_width="80dp"
                                    android:layout_height="80dp"
                                    app:cardBackgroundColor="#F7F8FA"
                                    app:cardCornerRadius="16dp"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical"
                                        android:gravity="center">

                                        <ImageView
                                            android:layout_width="26dp"
                                            android:layout_height="26dp"
                                            android:src="@drawable/plus"
                                            android:alpha="0.45"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Add"
                                            android:textSize="11sp"
                                            android:textColor="#AAAAAA"
                                            android:layout_marginTop="4dp"/>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ================= STEP 2: ADDRESS & DETAILS ================= -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Where and what?"
                    android:textSize="22sp"
                    android:textColor="#111111"
                    android:paddingBottom="16dp"
                    android:fontFamily="@font/poppins_bold"/>

                <!-- SECTION CARD: ADDRESS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="18dp"
                                android:background="#0F2CBD"
                                android:layout_marginRight="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Service Address"
                                android:textColor="#111111"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddAddress"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="start|center_vertical"
                            android:paddingStart="14dp"
                            android:text="Tap to set your address"
                            android:textAllCaps="false"
                            android:textColor="#777777"
                            android:textSize="14sp"
                            android:backgroundTint="#F7F8FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/location"
                            app:iconTint="#0F2CBD"
                            app:iconSize="18dp"
                            app:iconPadding="12dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECTION CARD: DETAILS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="18dp"
                                android:background="#0F2CBD"
                                android:layout_marginRight="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Order Details"
                                android:textColor="#111111"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddDetails"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:gravity="start|top"
                            android:paddingStart="14dp"
                            android:paddingTop="14dp"
                            android:text="Describe what needs to be done..."
                            android:textAllCaps="false"
                            android:textColor="#777777"
                            android:textSize="14sp"
                            android:backgroundTint="#F7F8FA"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/details"
                            app:iconTint="#0F2CBD"
                            app:iconSize="18dp"
                            app:iconPadding="12dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ================= STEP 3: PHOTOS & FARE ================= -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Final Touches"
                    android:textSize="22sp"
                    android:textColor="#111111"
                    android:paddingBottom="16dp"
                    android:fontFamily="@font/poppins_bold"/>

                <!-- SECTION CARD: PHOTOS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="18dp"
                                android:background="#0F2CBD"
                                android:layout_marginRight="10dp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Photos (Optional)"
                                android:textColor="#111111"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddPhotos"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="35dp"
                                android:text="+ Add Photos"
                                android:textAllCaps="false"
                                android:textColor="#0F2CBD"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:minWidth="0dp"
                                android:paddingLeft="4dp"
                                android:paddingRight="4dp"/>

                        </LinearLayout>

                        <!-- Photo thumbnails strip -->
                        <HorizontalScrollView
                            android:id="@+id/scrollPhotos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/layoutPhotoList"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="2dp">

                                <androidx.cardview.widget.CardView
                                    android:id="@+id/btnAddMorePhotos"
                                    android:layout_width="88dp"
                                    android:layout_height="88dp"
                                    app:cardBackgroundColor="#F7F8FA"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical"
                                        android:gravity="center">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/plus"
                                            android:alpha="0.5"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Add more"
                                            android:textSize="10sp"
                                            android:textColor="#AAAAAA"
                                            android:layout_marginTop="5dp"/>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </HorizontalScrollView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECTION CARD: OFFERED FARE -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="18dp"
                                android:background="#0F2CBD"
                                android:layout_marginRight="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your Offered Fare (Rs.)"
                                android:textColor="#111111"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etOfferedFare"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/input_bg"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:hint="Base Fare (e.g. 800)"
                            android:textColorHint="#CCCCCC"
                            android:inputType="number"
                            android:textSize="15sp"
                            android:textColor="#111111"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workers will see this price and can place counter-bids."
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── CONFIRM BUTTON — fixed at bottom ── -->
    <Button
        android:id="@+id/btnNextStep"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#0F2CBD"
        android:enabled="true"
        android:text="Next Step →"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/poppins_bold"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
