<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Worker Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/ivWorkerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/emp_profile"/>
            </androidx.cardview.widget.CardView>

            <!-- Worker Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Ali Raza"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/baseline_star_24"
                        app:tint="#FFC107"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvWorkerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4.8"
                        android:textSize="12sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold"/>
                        
                    <TextView
                        android:id="@+id/tvJobsCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text=" (124 jobs)"
                        android:textSize="12sp"
                        android:textColor="#777777"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/baseline_directions_car_24"
                        app:tint="#0F2CBD"
                        android:layout_marginEnd="4dp"/>
                        
                    <TextView
                        android:id="@+id/tvEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="10 mins away"
                        android:textSize="12sp"
                        android:textColor="#555555"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Bid Amount & Accept Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bid"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"/>

                <TextView
                    android:id="@+id/tvBidAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Rs 500"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnAcceptBid"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Accept"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0F2CBD"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    app:cornerRadius="18dp"
                    android:elevation="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
