<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Place Your Bid"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit a competitive bid to win this job."
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Bid Amount (Rs.)"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etBidAmount"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. 1500"
        android:inputType="number"
        android:paddingHorizontal="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0F2CBD"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cover Letter (Optional)"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etCoverLetter"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/input_bg"
        android:hint="Explain why you are the best fit..."
        android:inputType="textMultiLine"
        android:gravity="top|start"
        android:padding="16dp"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSubmitBid"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Submit Bid"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#0F2CBD"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"/>

</LinearLayout>
