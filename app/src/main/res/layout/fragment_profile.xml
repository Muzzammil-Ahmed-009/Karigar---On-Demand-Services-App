<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="30dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#0F2CBD"
            android:orientation="vertical"
            android:gravity="center">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/emp_profile"
                app:civ_border_width="3dp"
                app:civ_border_color="#FFFFFF"/>
            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muhammad Ali"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+92 300 1234567"
                android:textSize="14sp"
                android:textColor="#E0E0E0"/>
        </LinearLayout>

        <!-- Stats row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="16dp"
            android:background="@drawable/square_box"
            android:padding="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/tvTotalOrders" android:text="6" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="#1A1A1A"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Total Orders" android:textSize="12sp" android:textColor="#888888"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#EEEEEE"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/tvCompletedOrders" android:text="1" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="#0F2CBD"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Completed" android:textSize="12sp" android:textColor="#888888"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#EEEEEE"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/tvPendingOrders" android:text="4" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="#FF9800"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Active" android:textSize="12sp" android:textColor="#888888"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Edit Profile -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="10dp"
            android:background="@drawable/square_box" android:orientation="horizontal"
            android:gravity="center_vertical" android:id="@+id/btnEditProfile">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:layout_marginStart="16dp" android:src="@drawable/edit"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Edit Profile" android:textSize="16sp" android:layout_marginStart="14dp"
                android:textColor="#1A1A1A"/>
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/arrow" android:layout_marginEnd="16dp"/>
        </LinearLayout>

        <!-- Favorite Workers -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="10dp"
            android:background="@drawable/square_box" android:orientation="horizontal"
            android:gravity="center_vertical" android:id="@+id/btnFavoriteWorkers">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:layout_marginStart="16dp" android:src="@drawable/ic_heart_filled"
                app:tint="#FF3B30"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Favorite Workers" android:textSize="16sp" android:layout_marginStart="14dp"
                android:textColor="#1A1A1A"/>
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/arrow" android:layout_marginEnd="16dp"/>
        </LinearLayout>

        <!-- Contact Us -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="10dp"
            android:background="@drawable/square_box" android:orientation="horizontal"
            android:gravity="center_vertical" android:id="@+id/btnContactUs">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:layout_marginStart="16dp" android:src="@drawable/phone"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Contact Us" android:textSize="16sp" android:layout_marginStart="14dp"
                android:textColor="#1A1A1A"/>
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/arrow" android:layout_marginEnd="16dp"/>
        </LinearLayout>

        <!-- Logout -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="10dp"
            android:background="@drawable/square_box" android:orientation="horizontal"
            android:gravity="center_vertical" android:id="@+id/btnLogoutProfile">
            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:layout_marginStart="16dp" android:src="@drawable/logout"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Log Out" android:textSize="16sp" android:layout_marginStart="14dp"
                android:textColor="#F44336"/>
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/arrow" android:layout_marginEnd="16dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
