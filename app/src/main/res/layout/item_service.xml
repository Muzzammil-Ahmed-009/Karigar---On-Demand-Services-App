<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

        <!-- Icon circle -->
        <FrameLayout android:layout_width="54dp" android:layout_height="54dp"
            android:layout_marginEnd="16dp">
            <View android:layout_width="54dp" android:layout_height="54dp"
                android:id="@+id/serviceIconBg" android:background="@drawable/circle_bg"/>
            <ImageView android:id="@+id/ivServiceIcon" android:layout_width="30dp"
                android:layout_height="30dp" android:layout_gravity="center"
                android:src="@drawable/cleaning" android:scaleType="fitCenter"/>
        </FrameLayout>

        <!-- Text block -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvServiceName" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Cleaning"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A1A"/>
            <TextView android:id="@+id/tvServiceDesc" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Professional home cleaning"
                android:textSize="13sp" android:textColor="#888888" android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Arrow -->
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/arrow" android:alpha="0.4"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
