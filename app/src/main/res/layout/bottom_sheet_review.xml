<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bottom_sheet_bg">

    <View
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:background="#E0E0E0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvReviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rate your experience"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="@font/poppins_bold"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:id="@+id/tvReviewSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How was the service provided by the worker?"
        android:textSize="14sp"
        android:textColor="#666666"
        android:fontFamily="@font/poppins_regular"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:textAlignment="center"/>

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:numStars="5"
        android:stepSize="1.0"
        android:progressTint="#FFB300"
        android:secondaryProgressTint="#FFB300"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What did you like?"
        android:textSize="14sp"
        android:textColor="#1A1A1A"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPunctuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On Time"
            android:fontFamily="@font/poppins_regular"
            style="@style/Widget.MaterialComponents.Chip.Filter"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCleanliness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clean Workspace"
            android:fontFamily="@font/poppins_regular"
            style="@style/Widget.MaterialComponents.Chip.Filter"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipBehavior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Polite Behavior"
            android:fontFamily="@font/poppins_regular"
            style="@style/Widget.MaterialComponents.Chip.Filter"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipKnowledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professional"
            android:fontFamily="@font/poppins_regular"
            style="@style/Widget.MaterialComponents.Chip.Filter"/>
    </com.google.android.material.chip.ChipGroup>

    <EditText
        android:id="@+id/etReviewComments"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/chip_bg"
        android:hint="Leave a comment (optional)"
        android:gravity="top|start"
        android:padding="12dp"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:inputType="textMultiLine"/>

    <Button
        android:id="@+id/btnSubmitReview"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Submit Review"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0F2CBD"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_bold"/>

</LinearLayout>
