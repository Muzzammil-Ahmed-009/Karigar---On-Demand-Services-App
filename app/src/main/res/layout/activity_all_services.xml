<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- Toolbar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:background="#FFFFFF"
        android:elevation="4dp">
        <ImageView android:id="@+id/btnAllServicesBack" android:layout_width="40dp"
            android:layout_height="40dp" android:src="@drawable/back" android:padding="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="All Services" android:textSize="20sp" android:textStyle="bold"
            android:textColor="#1A1A1A" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" android:background="@drawable/square_box"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="12dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/details" android:alpha="0.5"/>
        <EditText android:id="@+id/etServiceSearch"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:hint="Search services..." android:textSize="14sp"
            android:textColor="#1A1A1A" android:textColorHint="#AAAAAA"
            android:background="@android:color/transparent"
            android:paddingStart="10dp" android:imeOptions="actionSearch"
            android:inputType="text"/>
    </LinearLayout>

    <!-- Scrollable services list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllServices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"/>

</LinearLayout>
