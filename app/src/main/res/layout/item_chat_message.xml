<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Left (Received) Message -->
    <LinearLayout
        android:id="@+id/layoutReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="start"
        android:maxWidth="280dp">

        <TextView
            android:id="@+id/tvMessageReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello, I am on my way."
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:padding="12dp"
            android:background="@drawable/square_box"
            android:backgroundTint="#E8E8E8"/>

        <TextView
            android:id="@+id/tvTimeReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00 AM"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Right (Sent) Message -->
    <LinearLayout
        android:id="@+id/layoutSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="end"
        android:maxWidth="280dp">

        <TextView
            android:id="@+id/tvMessageSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Okay, see you soon!"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="12dp"
            android:background="@drawable/square_box"
            android:backgroundTint="#0F2CBD"/>

        <TextView
            android:id="@+id/tvTimeSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:01 AM"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</LinearLayout>
