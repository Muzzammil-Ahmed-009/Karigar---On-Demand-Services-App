<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivWorkerPhoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/emp_profile"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_bg"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWorkerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Worker Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"/>

            <TextView
                android:id="@+id/tvWorkerProfession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profession"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvWorkerRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.8 ⭐"
                android:textSize="13sp"
                android:textColor="#F5A623"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCallWorker"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/call"
            android:background="@drawable/chip_bg"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"/>

        <ImageView
            android:id="@+id/btnRemoveFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_heart_filled"
            android:background="@drawable/chip_bg"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:tint="#FF3B30"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
