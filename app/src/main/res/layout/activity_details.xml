<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Order Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Heading -->
            <TextView
                android:id="@+id/labelAddDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Describe the work"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please provide a comprehensive brief for your service provider."
                android:textSize="13sp"
                android:textColor="#888888"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp"/>

            <!-- Text input card (white with border) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etOrderDetails"
                        android:layout_width="match_parent"
                        android:layout_height="370dp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:hint="Type your requirements here..."
                        android:textColorHint="#C0C0C0"
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="4dp"
                        android:inputType="textMultiLine"
                        android:scrollbars="vertical"/>

                    <!-- Character count row (bottom-right) + resize handle look -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvCharCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Character count: 0"
                            android:textSize="11sp"
                            android:textColor="#BBBBBB"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pro Tip card (light blue background) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EFF6FF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:layout_marginBottom="22dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/bulb"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvProTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="3dp"
                    android:text="Pro Tip: The more details you add, the better your service will be. Consider adding technical specs, deadlines, or specific style preferences."
                    android:textColor="#374151"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Attachments label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attachments (Optional)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginBottom="10dp"/>

            <!-- Attachment drop zone card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/attachmentCard"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FAFAFA"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/downoad"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload files or drag and drop"
                        android:textSize="13sp"
                        android:textColor="#AAAAAA"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF, JPG, PNG up to 10MB"
                        android:textSize="13sp"
                        android:textColor="#AAAAAA"/>


                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Save Requirements button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Requirements"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            app:cornerRadius="14dp"/>

    </LinearLayout>

</LinearLayout>
